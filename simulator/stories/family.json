        },
        {
          "screen": "app.chore-new",
          "state": "*",
          "kind": "tap",
          "target": "chore-new-kid-p-mateo",
          "text": "Elige a Mateo.",
          "sub": "Las sugerencias cambian con su edad."
        },
        {
          "screen": "app.chore-new",
          "state": "*",
          "kind": "tap",
          "target": "chore-new-suggest-2",
          "text": "Toca la sugerencia «Doblar su ropa»."
        },
        {
          "screen": "app.chore-new",
          "state": "*",
          "kind": "tap",
          "target": "chore-new-save",
          "text": "Toca «Guardar tarea»."
        },
        {
          "screen": "app.chores",
          "state": "default",
          "kind": "read",
          "target": "chores-list",
          "text": "Listo: Mateo la ve desde hoy en su día."
        }
      ]
    },
